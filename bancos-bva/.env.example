# bancos-bva — variables de entorno.
#
# Se busca, en orden: $FISCO_ENV_FILE -> <raiz del plugin>/.env -> ~/.fisco-ar/.env
# (el mismo .env que usa fisco-ar: si ya lo tenes configurado, no hace falta otro).
# NUNCA subir este archivo con valores a ningun lado.

# Planilla de claves de bancos (cifrada). Si no se define, se busca en
# <unidad>/0 - ESTUDIO - 00000000000/Claves_Bancos.xlsx
CLAVES_BANCOS_PATH=
# Contrasena con la que abre Claves_Bancos.xlsx. Si esta vacia se usa
# CLAVES_ORGANISMOS_PASSWORD (hoy es la misma).
CLAVES_BANCOS_PASSWORD=

# Raiz de la unidad compartida. Normalmente se detecta sola:
#   Windows: I:\Unidades compartidas\BVA - Sociedades Farmaceuticas
#   Mac:     ~/Library/CloudStorage/GoogleDrive-<cuenta>/Unidades compartidas/BVA - Sociedades Farmaceuticas
BVA_UNIDAD_PATH=

# Carpeta de salida de los extractos (default: ~/Documents/BVA-salidas -> /extractos)
BVA_SALIDAS_PATH=

# false = navegador visible (default: oculto; --ver lo muestra. Sin descarga
# automatica el banco se abre visible igual).
PLAYWRIGHT_HEADLESS=
