# Copiar como .env (o ~/.fisco-ar/.env) y completar. El .env NUNCA se sube al repo.

# Planilla de claves del estudio (Excel protegido con contrasena)
CLAVES_ORGANISMOS_PATH=
CLAVES_ORGANISMOS_PASSWORD=
# Hoja a leer si el Excel tiene varias (opcional)
CLAVES_ORGANISMOS_SHEET=

# ARQui (Quilmes): alternativa al grupo MUNICIPAL de la planilla (opcional)
# ARQUI_USUARIO=
# ARQUI_CLAVE=
# Pausa entre recibos y espera ante un bloqueo 403 de ARQui, en ms (opcional)
# ARQUI_PAUSA_MS=2500
# ARQUI_ESPERA_BLOQUEO_MS=180000

# Planilla con los numeros de cuenta de tasas municipales (default: la carpeta
# "0 - ESTUDIO - ..." de la unidad compartida). Acepta la ruta al .xlsx o a su carpeta.
TASAS_MUNICIPALES_PATH=

# Ruta a otro .env (opcional)
FISCO_ENV_FILE=

# Raiz de la unidad compartida de sociedades (default: la unidad I: de Windows)
BVA_UNIDAD_PATH=

# Python con openpyxl y pypdf (default: python3 en Mac/Linux, python en Windows)
BVA_PYTHON=

# Carpeta de salida de reportes y copias (default: ~/Documents/BVA-salidas)
BVA_SALIDAS_PATH=

# Navegador: false = visible
PLAYWRIGHT_HEADLESS=
PLAYWRIGHT_SLOWMO=
