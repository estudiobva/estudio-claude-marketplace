# Copiar como .env (o ~/.fisco-ar/.env, que comparten todos los plugins) y completar.
# El .env NUNCA se sube al repo.

# Raiz de la unidad compartida de sociedades (default: la unidad I: de Windows)
BVA_UNIDAD_PATH=

# Carpeta de salida (default: ~/Documents/BVA-salidas); el script usa <salida>/saldos-iva-iibb
BVA_SALIDAS_PATH=

# Ruta a otro .env (opcional)
FISCO_ENV_FILE=
