# Copiar como .env (o ~/.fisco-ar/.env) y completar. El .env NUNCA se sube al repo.

# Planilla de claves del estudio (Excel protegido con contrasena)
CLAVES_ORGANISMOS_PATH=
CLAVES_ORGANISMOS_PASSWORD=
# Hoja a leer si el Excel tiene varias (opcional)
CLAVES_ORGANISMOS_SHEET=

# Zetti (T&S Web): alternativa a las columnas ZETTI de la planilla (opcional)
# ZETTI_USUARIO=
# ZETTI_CLAVE=
# ZETTI_URL=http://zwebx.ddns.net:8085

# Alternativa a la planilla para ARCA (no la usa este plugin)
# ARCA_<cuit>_LOGIN=
# ARCA_<cuit>_PASSWORD=

# Ruta a otro .env (opcional)
FISCO_ENV_FILE=

# Raiz de la unidad compartida de sociedades (default: la unidad I: de Windows)
BVA_UNIDAD_PATH=

# Python con openpyxl (default: python3 en Mac/Linux, python en Windows)
BVA_PYTHON=

# Carpeta de salida de reportes y logs (default: ~/Documents/BVA-salidas)
BVA_SALIDAS_PATH=

# Navegador: false = visible
PLAYWRIGHT_HEADLESS=
PLAYWRIGHT_SLOWMO=
