# Copiar como .env (o ~/.fisco-ar/.env, que comparten todos los plugins) y completar.
# El .env NUNCA se sube al repo.

# Raiz de la unidad compartida de sociedades (default: la unidad I: de Windows)
BVA_UNIDAD_PATH=

# Planilla de seguimiento (default: <unidad>/0 - ESTUDIO - 00000000000/Seguimiento de pedidos Estudio-Cliente.xlsx)
PEDIDOS_PLANILLA=

# Carpeta de salidas (respaldos de la planilla). Default: ~/Documents/BVA-salidas
BVA_SALIDAS_PATH=

# Ruta a otro .env (opcional)
FISCO_ENV_FILE=
