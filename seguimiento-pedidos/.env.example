# Copiar como .env (o ~/.fisco-ar/.env, que comparten todos los plugins) y completar.
# El .env NUNCA se sube al repo.

# URL de la app web del Apps Script de la planilla (termina en /exec). Ver el README.
PEDIDOS_URL=

# Token de la app web (lo muestra instalar() en el editor de Apps Script). Es una clave: no compartir.
PEDIDOS_TOKEN=

# Ruta a otro .env (opcional)
FISCO_ENV_FILE=
